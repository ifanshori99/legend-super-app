# pnpm run setup creates private local values in .env.local (shared by both apps).
# Deployment environment: development | staging | production. NODE_ENV controls
# Node runtime optimizations separately and does not select this data policy.
DEPLOYMENT_MODE=development
# Edge is a deployment topology, not an environment: true | false.
EDGE_MODE=false
# Edge node only (EDGE_MODE=true; the cloud ignores these). The persistent link
# to the cloud API: wss://<cloud api host>/api/edge-link (ws:// only in
# development). The credential is shown ONCE when the node is registered at
# /api/edge-nodes on the cloud; keep it in the edge box's private env, never
# in the repository. Role: primary | standby. Version is the image version the
# node reports in heartbeats. The edge pulls the device registry from the cloud
# every EDGE_DEVICE_SYNC_INTERVAL_SECONDS (10..3600, default 60) and reports the
# replica as stale after EDGE_DEVICE_SYNC_STALE_SECONDS without a successful
# pull (60..86400, default 900, at least twice the interval). After
# EDGE_DEVICE_REGISTRY_MAX_STALE_SECONDS (3600..2592000, default 259200 = 72 h,
# at least twice the stale value above) without a pull the edge refuses NEW
# device sessions (enroll, token, first heartbeat); a device with a live
# heartbeat keeps running.
# EDGE_CLOUD_URL=
# EDGE_NODE_CREDENTIAL=
# EDGE_NODE_ROLE=primary
# EDGE_NODE_VERSION=dev
# EDGE_DEVICE_SYNC_INTERVAL_SECONDS=60
# EDGE_DEVICE_SYNC_STALE_SECONDS=900
# EDGE_DEVICE_REGISTRY_MAX_STALE_SECONDS=259200
# Edge link hardening (cloud and edge; safe defaults). After a credential
# rotation the previous credential still works for the grace hours (0..720).
# The cloud refuses link upgrades (429) from an address or node after this many
# failed authentications per window. Acked queue rows older than the retention
# days are pruned every hour.
# EDGE_CREDENTIAL_ROTATION_GRACE_HOURS=24
# EDGE_LINK_AUTH_FAILURE_LIMIT=10
# EDGE_LINK_AUTH_FAILURE_WINDOW_SECONDS=300
# EDGE_QUEUE_ACKED_RETENTION_DAYS=7
# Attendance selfie seal. Cloud: ATTENDANCE_SELFIE_SEAL_KEYS is JSON
# {"<kid>":"<PKCS#8 PEM, RSA >= 3072 bit>"} and ATTENDANCE_SELFIE_SEAL_ACTIVE_KID
# names the kid edges seal to (set both or neither; production secrets, never in
# the repository; keep an old kid 90 days after a switch). EDGE_QR_KEY_DAYS_AHEAD
# is how many QR day keys ahead the cloud sends each edge (0..14, default 3).
# Edge: sealed selfies wait in EDGE_SELFIE_DIR (default
# /var/lib/legend/edge-selfies) up to EDGE_SELFIE_MAX_BYTES (default 2 GiB).
# ATTENDANCE_SELFIE_SEAL_KEYS=
# ATTENDANCE_SELFIE_SEAL_ACTIVE_KID=
# EDGE_QR_KEY_DAYS_AHEAD=3
# EDGE_SELFIE_DIR=/var/lib/legend/edge-selfies
# Edge: local state files (owner alarm queue), a volume of its own, mode 0700.
# EDGE_STATE_DIR=/var/lib/legend/edge-state
# Edge primary only: run the EDC agent (card terminal) in this process. Off by
# default. Needs a supervisor with Restart=always (deploy/edge/legend-edge.service).
# EDC_AGENT_ENABLED=false
# Edge: the directory is a volume, mode 0700 (tenant subdirectories and files 0600).
# EDGE_SELFIE_MAX_BYTES=2147483648
# Upload worker interval (ms) and days a pending sealed file waits before it
# expires on the edge (legend-hubzo).
# EDGE_SELFIE_UPLOAD_INTERVAL_MS=30000
# EDGE_SELFIE_MAX_AGE_DAYS=30
# EDGE_OFFLINE_SWEEP_SECONDS=60
# EDGE_OFFLINE_ALARM_MINUTES=30
# Data classification: synthetic | real. Real data is allowed only in production.
DATA_CLASSIFICATION=synthetic
BETTER_AUTH_SECRET=
# Optional: keyed-digest secret for WhatsApp numbers and emails, so identity,
# reservation and CRM rows link on the same digest. Falls back to
# BETTER_AUTH_SECRET; set a dedicated value in production.
# CONTACT_HASH_SECRET=
# KirimDev webhook signing secret (AUTH-02). Comma-separated while rotating.
# Without it the WhatsApp reverse-OTP webhook answers 503 and processes nothing.
# KIRIM_WEBHOOK_SECRET=
# KirimDev API key for outbound WhatsApp (kdv_live_ + 24 characters). Optional:
# empty keeps outbound off. Request it with `ghostex secret request`.
# KIRIM_API_KEY=
# Optional KirimDev API base URL override (https only). Default https://api.kirimdev.com.
# KIRIM_API_BASE_URL=
# Delivery platform webhook signing secrets (legend-5bn3). Comma-separated while
# rotating. A platform without a secret is disabled (its webhook answers 503).
# DELIVERY_GOFOOD_WEBHOOK_SECRET=
# DELIVERY_GRABFOOD_WEBHOOK_SECRET=
# DELIVERY_SHOPEEFOOD_WEBHOOK_SECRET=
# Worker only (apps/api/src/worker-main.ts, legend-18qw). The worker refuses to
# start without a transport and all three notification channel settings.
# WORKER_TRANSPORT=builtin
# Channel providers: email disabled | brevo; push disabled | web_push;
# WhatsApp disabled. Disabled push rejects panic fallback events visibly so
# they remain retryable; it must be enabled before relying on phone alerts.
# NOTIFICATION_EMAIL_PROVIDER=disabled
# NOTIFICATION_PUSH_PROVIDER=disabled
# NOTIFICATION_WHATSAPP_PROVIDER=disabled
# Only with NOTIFICATION_EMAIL_PROVIDER=brevo:
# BREVO_API_KEY=
# NOTIFICATION_EMAIL_FROM=
# NOTIFICATION_EMAIL_FROM_NAME=
# Only with NOTIFICATION_PUSH_PROVIDER=web_push (do not use sample keys). The API
# also reads these three: it serves the public key to browsers and refuses to
# boot with web_push and a missing or mismatched pair (legend-ofq4f).
# Production: generate the pair once on the server with
# `npx web-push generate-vapid-keys`, never commit it. Rotating it means every
# browser must register again. `pnpm run setup` makes a throwaway dev pair.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=
# VAPID_SUBJECT is a real mailto: contact or HTTPS contact URL. Subscriptions
# are sealed using the existing DATA_ENCRYPTION_KEY/key rotation settings.
# Object storage settings are one set only: STORAGE_S3_* (see "Object storage,
# S3-compatible" further down). The older OBJECT_STORAGE_* names still work as a
# deprecated fallback (one startup warning); if both are set with different
# values the API refuses to start. Do not fill both.
# Google sign-in for customers (legend-k2l). Set both or neither; with neither,
# Google sign-in is off. Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Member sign-in email over SMTP (legend-k2l). SMTP_HOST, SMTP_USER, SMTP_PASS
# and EMAIL_FROM together or none; none = email sign-in off.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=
# Optional: base64 of 32 bytes, seals integration credentials and NPWP at rest.
# Production requires it; development derives a key from BETTER_AUTH_SECRET.
# DATA_ENCRYPTION_KEY=
# Optional rotation of DATA_ENCRYPTION_KEY (integration credentials, NPWP, QR and
# other sealed secrets). Version 1 is DATA_ENCRYPTION_KEY and stays set; add keys
# as comma-separated <version>:<base64 of 32 bytes> entries (versions 2..255; the
# version is the first byte of each sealed value), set the active version new
# data is sealed with (API and worker alike), then re-seal stored credentials with
# rotateIntegrationCredentials. Keep old keys until nothing is sealed under them.
# See docs/deployment.md "Rotasi kunci data (DATA_ENCRYPTION_KEY)".
# DATA_ENCRYPTION_KEYS=
# DATA_ENCRYPTION_ACTIVE_KEY_VERSION=1
# Optional HRIS and payroll sealed-value key rotation. Version 1 is DATA_ENCRYPTION_KEY,
# which also still seals other secrets and the HRIS blind indexes: keep it set
# even after rotating. Add keys as comma-separated <version>:<base64 of 32 bytes>
# entries (versions 2 and up), then set the active version new data is sealed
# with (API and worker alike) and queue the hris-pii-reseal job with
# {"targetKeyVersion": <that version>} (a job without it, or with another
# version, is refused). Keep old keys until it finished with no incomplete
# tenants. See docs/deployment.md "Rotasi kunci HRIS dan payroll".
# HRIS_PII_KEYS=
# HRIS_PII_ACTIVE_KEY_VERSION=1
# Blind-index key version for HRIS equality lookups and legal-entity NPWP
# uniqueness: 1 = legacy HMAC under DATA_ENCRYPTION_KEY (default), 2 = HKDF
# subkey of it (no new secret). Set 2 by hand only after every pod runs the
# new build. 1 is also the rollback lever: set it on API and worker, then queue
# blind-index-rebuild with {"targetVersion": 1}. See docs/deployment.md
# "Versi blind index".
# BLIND_INDEX_ACTIVE_VERSION=1
# Malware scanner for uploads (legend-w9hwh): a ClamAV daemon (clamd). Leave
# CLAMD_HOST empty for none (production then refuses PDF uploads; images are
# still re-encoded). See docs/deployment.md "Pemindai malware (ClamAV)".
# CLAMD_HOST=
# CLAMD_PORT=3310
# CLAMD_TIMEOUT_MS=15000
# Scan concurrency (legend-1rtm1): running at once overall / per tenant, and how
# many may wait for a slot; beyond that uploads get 503 SCANNER_OVERLOADED.
# CLAMD_MAX_CONCURRENT=4
# CLAMD_MAX_PER_TENANT=2
# CLAMD_MAX_QUEUED=8
# Staff device PIN pepper, CLOUD ONLY: 32+ random characters, its own secret
# (never BETTER_AUTH_SECRET). Production requires it; development/tests use a
# fixed non-secret fallback. An edge node (EDGE_MODE=true) refuses to start with
# it set: the edge receives only its own tenant's derived pepper from the cloud.
# Replacing it invalidates every stored PIN; rotate with the version below.
# STAFF_PIN_PEPPER=
# Pepper generation new PINs are hashed under (cloud only, default 1). Raise it
# to rotate: older generations still verify until staff set a new PIN, and each
# edge fetches the new tenant pepper on its next sync.
# STAFF_PIN_PEPPER_CURRENT_VERSION=1
# Attendance selfie seal keys: see the block under the edge settings above and
# docs/deployment.md "Attendance selfie seal key" (founder backup in 1Password).
# Without the keys the cloud answers 503 SELFIE_SEAL_KEY_MISSING to edge uploads.
# Public origin of the Express API. Better Auth issues cookies from here.
BETTER_AUTH_URL=http://localhost:4000
# Origin of the TanStack Start web app. Allowed by CORS and Better Auth.
WEB_URL=http://localhost:3000
# Optional extra comma-separated origins allowed to call the API with cookies.
# TRUSTED_ORIGINS=
# API origin the browser calls. Baked into the web build; keep it equal to BETTER_AUTH_URL.
VITE_API_URL=http://localhost:4000
# Optional API origin the web server uses during SSR (e.g. http://api:4000 in Docker).
# API_INTERNAL_URL=
# Production only: shared parent domain so app.example.com and api.example.com
# share the session cookie, e.g. .example.com. Leave unset for localhost.
# COOKIE_DOMAIN=
# Production: hostname tenants' default subdomains live under (<slug>.<domain>).
# It and everything under it, plus COOKIE_DOMAIN, are reserved: tenants cannot
# add them as custom domains.
# PLATFORM_DOMAIN=
# Development synthetic data only: loopback public reads preview this verified
# tenant domain. Managed local dev:prepare fills it from the seeded website;
# production, staging, test and nonlocal requests do not use this alias.
# DEV_PUBLIC_SITE_HOST=
# Set when the API runs behind a reverse proxy: a hop count (e.g. 1) or subnets
# (e.g. loopback). Never true: that trusts any client-supplied X-Forwarded-For.
# TRUST_PROXY=
# Shared secret Caddy sends as X-Tls-Ask-Token before issuing an on-demand
# certificate for a brand custom domain. Required in production (the ask fails
# closed without it); leave unset only for local development.
# TLS_ASK_TOKEN=
# fatal | error | warn | info | debug | trace | silent. Defaults: debug in dev, info in production.
# LOG_LEVEL=
# Log every SQL statement (parameters omitted) at debug level.
# LOG_SQL=false
# Pay approved refunds out through DOIT (kill switch). Default false: refunds
# stay approved and unpaid until this is true. Enable only after the DOIT
# refund flow has been verified against the live account. The API and the
# worker must have the same value (absent, empty, 0 and false all mean off):
# deploy/single-vm/deploy.sh refuses to deploy when api.env and worker.env
# differ, and both processes log the value at startup.
# DOIT_REFUNDS_ENABLED=false
# DOIT recurring billing back office (/api/payments/recurring). Default false:
# every request answers 503 before any DOIT call or database write, because the
# adapter paths (/v1/recurring/*) differ from the DOIT docs (/v1/billing/*).
# Webhook ingest and the worker are not gated. Enable only once verified.
# DOIT_RECURRING_ENABLED=false
# Duitku payment gateway: public origin of this API (Duitku posts callbacks to
# <origin>/api/webhooks/payments/duitku/<tenantId>) and the page a customer
# returns to after paying. https in production. Unset = Duitku adapter off.
# Sandbox or production Duitku is set per integration in the app.
# DUITKU_CALLBACK_BASE_URL=
# DUITKU_RETURN_URL=
# Public API reads without a session (guest QR scan/menu, brand website, SSR
# brand context, payment links) are limited per client IP and per resolved
# tenant, per minute. Defaults: 600 and 6000. Guests behind one venue NAT
# address share the IP bucket, so raise the IP limit rather than disable it.
# PUBLIC_RATE_LIMIT_PER_MINUTE=600
# PUBLIC_RATE_LIMIT_TENANT_PER_MINUTE=6000
# Guest table-session routes (cart, bill, payments, polled every 2-5 s) have
# their own per-tenant bucket across all outlets, and a per-IP budget of 10x
# PUBLIC_RATE_LIMIT_PER_MINUTE for a venue NAT. Default 60000.
# PUBLIC_RATE_LIMIT_GUEST_TENANT_PER_MINUTE=60000
# Web server address(es) whose SSR calls skip the per-IP bucket (Docker: add the web container IP).
# PUBLIC_RATE_LIMIT_INTERNAL_IPS=127.0.0.1,::1,::ffff:127.0.0.1
# Share the public rate-limit windows across API instances (legend-bpvf). Unset = in-memory per process.
# REDIS_URL=
# Same value (min 32 chars) on API and web: the API then trusts the visitor IP the web server forwards (legend-moe5).
# SSR_SHARED_SECRET=
# Web only: proxies in front of the web server (Cloudflare + Caddy = 2).
# WEB_TRUST_PROXY_HOPS=2
# Leave blank for automatic Docker setup, or supply your own connection string.
DATABASE_URL=
# API login (restricted, non-owner). Generated for managed local development.
# APP_DATABASE_URL=
# Worker queue login (owns only the pgboss schema). Deployments provision both
# restricted logins with deploy/single-vm/provision-roles.sh (docs/deployment.md).
# WORKER_DATABASE_URL=
# Audit retention login: legend_maint_<16 hex>, member of legend_maintenance,
# runs only the two audit retention functions. Required to start the cloud
# worker in production (worker.env only for cloud deployments).
# Edge API: optional in the private edge API env file; points to the local edge
# database with its own maintenance login (deploy/edge/README.md). When absent,
# audit purge is skipped; a local error and heartbeat flag request owner action.
# Offline POS remains available; cloud alarm delivery requires connectivity.
# A configured but invalid connection or role refuses startup. Never use an
# application login or migration-owner credentials for this key.
# MAINTENANCE_DATABASE_URL=
# Payout step grant login: legend_grant_<16 hex>, member of legend_payout_grantor,
# runs only app.payout_grant_issue (api.env only). Required by production APIs.
# Managed pnpm dev:prepare and isolated test/e2e runs generate and provision
# this separate login automatically. legend_payout_grantor itself is NOLOGIN;
# never use application or migration-owner credentials for this connection.
# PAYOUT_GRANTOR_DATABASE_URL=
# Frozen-column re-seal login: legend_reseal_<16 hex>, the only member of
# legend_sealed_reseal (INHERIT, no SET), runs only app.reseal_frozen_sealed.
# Optional, worker only: without it the re-seal job skips rows in frozen tables
# and the old key cannot be retired. Never use an application, queue or
# migration-owner login here (docs/deployment.md).
# RESEAL_DATABASE_URL=
# Optional direct connection for migrations when DATABASE_URL uses a pooler.
MIGRATION_DATABASE_URL=
# Migrator session limits (docs/deployment.md, legend-jluo). Lock wait before
# the migration gives up and rolls back (default 10s; 0 = wait forever), and a
# per-statement limit (default 0 = none, so long backfills are not cut).
# MIGRATION_LOCK_TIMEOUT=10s
# MIGRATION_STATEMENT_TIMEOUT=0
# Optional fixed local database port. Setup chooses a free high port by default.
# POSTGRES_PORT=5433

# Frontend mock mode (development only; never set in deploy configs)
VITE_API_MOCK=
VITE_API_MOCK_LATENCY_MS=

# AI gateway (WS-12). AI stays OFF until a provider key is set.
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=low
# AI_BASE_URL=
# AI_API_KEY=
# AI_TIMEOUT_MS=30000
# MCP_TOKEN_TTL_SECONDS=3600

# Object storage, S3-compatible (legend-dzh9q): uploads, HRIS files and profit
# share statement PDFs, one set for all of them (legend-94xqo). Leave all empty
# to run without storage (uploads answer 503, statements are not issued, selfie
# purge job off). Set the six required keys together (region included); a partial set stops the
# app and the worker at start. The public and private buckets must differ.
# Required: access key, secret, private bucket, public bucket, public base URL.
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_PRIVATE_BUCKET=
STORAGE_S3_PUBLIC_BUCKET=
# https URL that serves the public bucket (no credentials, query or hash).
STORAGE_PUBLIC_BASE_URL=
# Optional: custom endpoint (MinIO, R2) and
# path-style addressing ("true" for MinIO).
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_FORCE_PATH_STYLE=

# ChatGPT/Codex device login: global kill switch, OFF unless explicitly enabled.
# Tenant owner consent is required separately. Set false to disable all connections.
AI_CHATGPT_ENABLED=false
# First ChatGPT connection default; existing selected models remain unchanged.
# Plan eligibility is still decided by ChatGPT. The owner API may choose another model.
AI_CHATGPT_MODEL=gpt-6.1-sol
