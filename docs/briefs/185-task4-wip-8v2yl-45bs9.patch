+describe("legend-8v2yl legend-45bs9 a POS refund is attributed per tender when one method has several intents", () => {
+  it("a 30000 POS refund of a qris sale paid by intent A (60000) then B (40000) records its tender parts; A can refund 30000, not 30001; B nothing", async () => {
+    const intentA = await paidIntent(60_000);
+    const intentB = await paidIntent(40_000);
+    const orderId = await posOrder(100_000);
+    const tenderA = await qrisTender(orderId, intentA, 60_000, 2);
+    await qrisTender(orderId, intentB, 40_000, 1);
+
+    const refund = await posRefund(orderId, 30_000);
+
+    // The contract DTO keeps its shape; the row carries the tender parts.
+    expect(refund.lines).toEqual([
+      { method: "qris", amountIdr: 30_000, reference: null },
+    ]);
+    expect(await storedLines(refund.id)).toEqual([
+      {
+        method: "qris",
+        amountIdr: 30_000,
+        reference: null,
+        tenders: [
+          { tenderId: tenderA, paymentIntentId: intentA, amountIdr: 30_000 },
+        ],
+      },
+    ]);
+
+    await expectRefused(intentA, 30_001);
+    await expectRefused(intentB, 1);
+    expect(await ledgerNet(intentA)).toBe(30_000);
+    expect(await ledgerNet(intentB)).toBe(40_000);
+    expect(await ledgerCandidates(intentA)).toEqual([refund.id]);
+    expect(await ledgerCandidates(intentB)).toEqual([]);
+    await expectCreated(intentA, 30_000);
+  });
+
+  it("a later 50000 POS refund takes what is left on A (30000) then 20000 of B; A can refund nothing, B 20000 but not 20001", async () => {
+    const intentA = await paidIntent(60_000);
