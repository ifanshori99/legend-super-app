+/**
+ * legend-8v2yl, legend-45bs9: the part of each captured tender every line of
+ * a new refund returns, so a method paid by several payment intents (two QRIS
+ * scans) is attributed per intent (pos-intent-attribution.ts). Per method, in
+ * tender order (tendersOf: requested at, then id), each tender gives up to
+ * what earlier refunds left on it: their recorded parts first, then their
+ * method-only (older rows) amounts taken in that same tender order. A part is
+ * never negative nor above what is left on its tender. A line the tenders
+ * cannot fully cover (inconsistent older rows) records no parts and keeps the
+ * method-only attribution (fail closed).
+ */
+export function refundTenderParts(
+  tenders: readonly PosTender[],
+  refunds: readonly Pick<RefundRow, "lines">[],
+  lines: readonly { method: string; amountIdr: number }[],
+): (PosRefundTenderPartRow[] | null)[] {
+  const captured = tenders.filter((tender) => tender.status === "captured");
+  const left = new Map(
+    captured.map((tender) => [tender.id as string, Number(tender.amountIdr)]),
+  );
+  const methodOnly = new Map<string, number>();
+  for (const row of refunds)
+    for (const line of row.lines) {
+      let rest = Number(line.amountIdr);
+      for (const part of line.tenders ?? []) {
+        left.set(
+          part.tenderId,
+          Math.max(0, (left.get(part.tenderId) ?? 0) - part.amountIdr),
+        );
+        rest -= part.amountIdr;
+      }
+      if (rest > 0)
+        methodOnly.set(line.method, (methodOnly.get(line.method) ?? 0) + rest);
+    }
+  const take = (method: string, amountIdr: number) => {
+    const parts: PosRefundTenderPartRow[] = [];
+    let rest = amountIdr;
+    for (const tender of captured) {
+      if (rest <= 0) break;
+      if (tender.method !== method) continue;
+      const part = Math.min(rest, left.get(tender.id) ?? 0);
+      if (part <= 0) continue;
+      left.set(tender.id, (left.get(tender.id) ?? 0) - part);
+      rest -= part;
+      parts.push({
+        tenderId: tender.id,
+        paymentIntentId: tender.paymentIntentId,
+        amountIdr: part,
+      });
+    }
+    return rest === 0 ? parts : null;
+  };
+  for (const [method, amountIdr] of methodOnly) take(method, amountIdr);
+  return lines.map((line) => take(line.method, line.amountIdr));
+}
