@@ -0,0 +1,470 @@
+// POS refund attribution per tender (beads legend-8v2yl, legend-45bs9, tier K
+// / money). A POS refund line names a method; when one method (qris) of an
+// order was paid by several payment intents, the old attribution gave
+// nothing back to any of them (fail closed): the intent refund stayed blocked
+// and the payout stayed parked. The refund writer now records, per line, the
+// part of each tender it returned (`lines[i].tenders`), and the attribution
+// (pos-intent-attribution.ts) gives each intent back its own tenders' parts.
+//
+// Real Express app, Better Auth, services and PostgreSQL. Same seeding and
+// request style as payment-refund-pos-tender-guard.test.ts (helpers copied).
+//
+// Assumptions where the brief is not exact:
+// - Within a method the refund fills the tenders in tender order (requested
+//   at, then id), each up to what earlier refunds left on it. Earlier
+//   method-only (legacy) lines consume the tenders in that same order.
+// - The POS refund is approved by a supervisor PIN override row inserted
+//   directly (approved, fresh, by a second real user).
+import { randomUUID } from "node:crypto";
+import type { PoolClient } from "pg";
+import { sql } from "drizzle-orm";
+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import {
+  outletIdSchema,
+  tenantIdSchema,
+  userIdSchema,
+  uuidToUlid,
+  type ScopedTenantContext,
+} from "@starter/shared/core";
+import {
+  establishScopedTenantContext,
+  establishTenantContext,
+} from "@starter/shared/core/server";
+import { createApp } from "../app";
+import { db } from "../db/index.ts";
+import { withTenant } from "../db/tenant.ts";
+import {
+  netPosTendersOfIntentSql,
+  posRefundsOfIntentSql,
+} from "../services/pos-intent-attribution.ts";
+import { refundPosOrder } from "../services/pos-order-corrections.ts";
+import { agent, originHeader, signUp, verifySessionMfa } from "./helpers";
+import {
+  owner,
+  seededOutletA,
+  seededTenantId,
+  staffWithRole,
+  type Staff,
+} from "./floor-test-helpers";
+
+const ADMIN = "/api/payments/admin";
+const GUARD_CODE = "REFUND_INTENT_IN_POS_SALE";
+
+async function asOwner<T>(run: (client: PoolClient) => Promise<T>): Promise<T> {
+  const client = await owner.connect();
+  try {
+    await client.query("BEGIN");
+    await client.query(
+      "SELECT set_config('app.tenant_id', $1, true), set_config('app.outlet_ids', '*', true)",
+      [seededTenantId],
+    );
+    const result = await run(client);
+    await client.query("COMMIT");
+    return result;
+  } catch (error) {
+    await client.query("ROLLBACK");
+    throw error;
+  } finally {
+    client.release();
+  }
+}
+
+const app = createApp();
+let staff: Staff;
+let approverId = "";
+const intentIds: string[] = [];
+const linkIds: string[] = [];
+const orderIds: string[] = [];
+const overrideIds: string[] = [];
+
+const key = (prefix = "attr") => `${prefix}-${randomUUID()}`;
+
+function scopedContext(): ScopedTenantContext {
+  return establishScopedTenantContext(
+    establishTenantContext({
+      tenantId: tenantIdSchema.parse(seededTenantId),
+      brandId: null,
+      source: "session",
+    }),
+    { kind: "tenant" },
+  );
+}
+
+/** A paid intent (with evidence) that belongs to no order or reservation. */
+async function paidIntent(amountIdr: number): Promise<string> {
+  const linkId = randomUUID();
+  const intentId = randomUUID();
+  await asOwner(async (client) => {
+    await client.query(
+      `INSERT INTO payment_links
+         (id, tenant_id, outlet_id, token_hash, reference, subtotal_idr, total_idr, paid_idr, created_by)
+       VALUES ($1, $2, $3, $4, $5, $6, $6, $6, 'tender-attr-test')`,
+      [
+        linkId,
+        seededTenantId,
+        seededOutletA,
+        randomUUID().replaceAll("-", "").padEnd(64, "0"),
+        `TA-${linkId.slice(0, 8)}`,
+        amountIdr,
+      ],
+    );
+    await client.query(
+      `INSERT INTO payment_intents
+         (id, tenant_id, outlet_id, payment_link_id, method, provider, amount_idr,
+          idempotency_key, status, instructions, expires_at, paid_at)
+       VALUES ($1, $2, $3, $4, 'qris', 'doit', $5, $6, 'paid',
+               '{"method":"qris","qrPayload":"00020101021226TEST","issuer":null}', now() + interval '1 hour', now())`,
+      [
+        intentId,
+        seededTenantId,
+        seededOutletA,
+        linkId,
+        amountIdr,
+        `ta-pay-${intentId}`,
+      ],
+    );
+    await client.query(
+      `INSERT INTO payment_evidence (tenant_id, outlet_id, payment_intent_id, provider, provider_ref, method, source, amount_idr, received_at)
+       VALUES ($1, $2, $3, 'doit', $4, 'qris', 'verified_webhook', $5, now())`,
+      [
+        seededTenantId,
+        seededOutletA,
+        intentId,
+        `evidence-${intentId}`,
+        amountIdr,
+      ],
+    );
+  });
+  linkIds.push(linkId);
+  intentIds.push(intentId);
+  return intentId;
+}
+
+/** A completed POS order of `totalIdr` (orders + pos_orders). */
+async function posOrder(totalIdr: number): Promise<string> {
+  const id = randomUUID();
+  orderIds.push(id);
+  await asOwner(async (client) => {
+    await client.query(
+      `INSERT INTO orders (id, tenant_id, outlet_id, number, channel, service_type, payment_mode,
+         subtotal_idr, discount_idr, service_charge_idr, tax_idr, rounding_idr, total_idr,
+         status, business_date, placed_at)
+       VALUES ($1, $2, $3, $4, 'pos', 'takeaway', 'pay_first', $5, 0, 0, 0, 0, $5,
+         'completed', '2026-11-09', now())`,
+      [
+        id,
+        seededTenantId,
+        seededOutletA,
+        `TA-${randomUUID().slice(0, 8)}`,
+        totalIdr,
+      ],
+    );
+    await client.query(
+      `INSERT INTO pos_orders (order_id, tenant_id, outlet_id, channel, submitted_at, completed_at)
+       VALUES ($1, $2, $3, 'pos', now(), now())`,
+      [id, seededTenantId, seededOutletA],
+    );
+  });
+  return id;
+}
+
+/**
+ * A captured QRIS tender of `amountIdr` on the order that uses `intentId`,
+ * requested `minutesAgo` minutes ago (fixes the tender order).
+ */
+async function qrisTender(
+  orderId: string,
+  intentId: string,
+  amountIdr: number,
+  minutesAgo: number,
+): Promise<string> {
+  const { rows } = await owner.query<{ id: string }>(
+    `INSERT INTO pos_order_tenders (tenant_id, outlet_id, order_id, method, provider,
+        payment_intent_id, amount_idr, status, requested_at, resolved_at)
+     VALUES ($1, $2, $3, 'qris', 'doit', $4, $5, 'captured',
+             now() - make_interval(mins => $6::int), now())
+     RETURNING id`,
+    [seededTenantId, seededOutletA, orderId, intentId, amountIdr, minutesAgo],
+  );
+  return rows[0]!.id;
+}
+
+/** A legacy POS refund row: one method-only QRIS line, no tender parts. */
+async function legacyQrisRefund(orderId: string, amountIdr: number) {
+  await owner.query(
+    `INSERT INTO pos_order_refunds (tenant_id, outlet_id, order_id, amount_idr, reason, reason_note,
+        lines, requested_by, approved_by, approval_request_id, refunded_at)
+     VALUES ($1, $2, $3, $4, 'customer_cancelled', 'Uji', $5::jsonb,
+             'kasir-uji', 'supervisor-uji', $6, now())`,
+    [
+      seededTenantId,
+      seededOutletA,
+      orderId,
+      amountIdr,
+      JSON.stringify([{ method: "qris", amountIdr, reference: null }]),
+      randomUUID(),
+    ],
+  );
+}
+
+/** A fresh supervisor PIN approval of a refund of the order (pos_overrides). */
+async function refundApproval(orderId: string, valueIdr: number) {
+  const id = randomUUID();
+  overrideIds.push(id);
+  await asOwner((client) =>
+    client.query(
+      `INSERT INTO pos_overrides (id, tenant_id, outlet_id, action, method, status,
+          requested_by, approved_by, reason, value_idr, object_type, object_id,
+          request_fingerprint, created_at, resolved_at)
+       VALUES ($1, $2, $3, 'refund', 'supervisor_pin', 'approved', $4, $5,
+               'Persetujuan uji atribusi', $6, 'order', $7, 'attr-test', now(), now())`,
+      [
+        id,
+        seededTenantId,
+        seededOutletA,
+        staff.userId,
+        approverId,
+        valueIdr,
+        uuidToUlid(orderId),
+      ],
+    ),
+  );
+  return { approvedBy: approverId, overrideId: uuidToUlid(id) };
+}
+
+/** POS refund of `amountIdr` through the writer (pos-order-corrections). */
+async function posRefund(orderId: string, amountIdr: number) {
+  return refundPosOrder(
+    scopedContext(),
+    {
+      userId: userIdSchema.parse(staff.userId),
+      deviceId: null,
+      expectedVersion: null,
+    },
+    outletIdSchema.parse(seededOutletA),
+    uuidToUlid(orderId),
+    {
+      reason: "customer_cancelled",
+      reasonNote: "Uji atribusi tender",
+      amountIdr,
+      idempotencyKey: randomUUID(),
+      ...(await refundApproval(orderId, amountIdr)),
+    } as Parameters<typeof refundPosOrder>[4],
+  );
+}
+
+async function storedLines(refundId: string) {
+  const { rows } = await owner.query<{ lines: unknown }>(
+    "SELECT lines FROM pos_order_refunds WHERE tenant_id = $1 AND id = $2",
+    [seededTenantId, refundId],
+  );
+  return rows[0]!.lines;
+}
+
+const requestRefund = (intentId: string, amountIdr: number) =>
+  staff.client
+    .post(`${ADMIN}/refunds`)
+    .set(originHeader)
+    .send({
+      idempotencyKey: key("req"),
+      paymentIntentId: intentId,
+      amountIdr,
+      reason: "Pengembalian uji atribusi tender",
+    });
+
+async function expectRefused(intentId: string, amountIdr: number) {
+  const response = await requestRefund(intentId, amountIdr);
+  expect(response.status, JSON.stringify(response.body)).toBe(409);
+  expect(response.body.error.code).toBe(GUARD_CODE);
+}
+
+async function expectCreated(intentId: string, amountIdr: number) {
+  const response = await requestRefund(intentId, amountIdr);
+  expect(response.status, JSON.stringify(response.body)).toBe(201);
+}
+
+/** The ledger-mode net of the intent with every sale and POS refund kept. */
+async function ledgerNet(intentId: string): Promise<number> {
+  const result = await withTenant(db, scopedContext(), (tx) =>
+    tx.execute(
+      netPosTendersOfIntentSql(seededTenantId, intentId, {
+        kind: "ledger",
+        sales: sql`TRUE`,
+        posRefunds: sql`TRUE`,
+      }),
+    ),
+  );
+  return Number(result.rows[0]?.amount ?? "0");
+}
+
+async function ledgerCandidates(intentId: string): Promise<string[]> {
+  const result = await withTenant(db, scopedContext(), (tx) =>
+    tx.execute(
+      posRefundsOfIntentSql(seededTenantId, intentId, {
+        sales: sql`TRUE`,
+        posRefunds: sql`TRUE`,
+      }),
+    ),
+  );
+  return result.rows.map((row) => String(row.id));
+}
+
+beforeAll(async () => {
+  if (!process.env.STARTER_TEST_RUN?.startsWith("starter-pg-test-"))
+    throw new Error("Requires the disposable test database");
+  staff = await staffWithRole(app, {
+    template: "owner",
+    label: "Tender Attribution Owner",
+  });
+  await verifySessionMfa(staff.email);
+  const approver = agent(app);
+  await signUp(approver, "Tender Attribution Supervisor");
