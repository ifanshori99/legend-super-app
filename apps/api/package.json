{
  "name": "@starter/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --include ../../packages/shared/src --include ../../.env.local --include ../../.env src/server.ts",
    "build": "tsup",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:reset-preswitch-refunds": "tsx src/db/reset-preswitch-refund-payouts.ts",
    "db:backfill-employee-managers": "tsx src/db/backfill-employee-managers.ts",
    "db:studio": "drizzle-kit studio",
    "db:backfill-defaults": "tsx src/db/backfill-tenant-defaults.ts",
    "db:rotate-data-key": "tsx src/db/rotate-data-key.ts",
    "role:set": "tsx src/set-role.ts",
    "worker": "node --enable-source-maps dist/worker.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@pdf-lib/fontkit": "1.1.1",
    "@simplewebauthn/server": "14.0.3",
    "@starter/shared": "workspace:*",
    "better-auth": "catalog:",
    "cors": "2.8.6",
    "drizzle-orm": "catalog:",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "ioredis": "^6.0.0",
    "multer": "^2.5.0",
    "nodemailer": "10.4.0",
    "pdf-lib": "1.17.1",
    "pg": "catalog:",
    "pg-boss": "^12.38.0",
    "pino": "catalog:",
    "pino-http": "11.0.0",
    "sharp": "^0.35.5",
    "web-push": "3.6.7",
    "ws": "^8.22.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "catalog:",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "catalog:",
    "@types/supertest": "7.2.1",
    "@types/web-push": "3.6.4",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "5.0.3",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "catalog:",
    "supertest": "7.3.1",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vitest": "5.0.3"
  }
}
