# Non-secret example only. Keep real credentials in a private operator env file.
API_HEALTH_URL=https://api.example.test/api/health/ready
WEB_HEALTH_URL=https://web.example.test/
MONITOR_STATE_FILE=/var/lib/legend-monitor/outlet-state.json

# Existing authenticated relay mode; choose a relay or direct provider per channel.
ALERT_EMAIL_PROVIDER=relay
ALERT_EMAIL_RELAY_URL=
ALERT_EMAIL_RELAY_TOKEN=
ALERT_WHATSAPP_PROVIDER=relay
ALERT_WHATSAPP_RELAY_URL=
ALERT_WHATSAPP_RELAY_TOKEN=

# For ALERT_EMAIL_PROVIDER=brevo:
ALERT_BREVO_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# For ALERT_WHATSAPP_PROVIDER=kirimdev (approved one-parameter body template):
ALERT_KIRIMDEV_API_KEY=
ALERT_WHATSAPP_PHONE_NUMBER_ID=
ALERT_WHATSAPP_TO=
ALERT_WHATSAPP_TEMPLATE_NAME=
ALERT_WHATSAPP_TEMPLATE_LANGUAGE=id

# Target one trusted tenant/outlet in the private edge database.
MONITOR_OPERATIONAL_ENABLED=false
MONITOR_TENANT_ID=
MONITOR_OUTLET_ID=
MONITOR_DEVICE_MAX_AGE_SECONDS=120
MONITOR_QUEUE_MAX_PENDING=100
MONITOR_SYNC_MAX_AGE_SECONDS=300

# psql reads PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD, PGSSLMODE.
# Reuse the operator's existing private database connection; do not expose it.
MONITOR_XMIN_ENABLED=false
MONITOR_XMIN_MAX_AGE_SECONDS=600
