# Copy outside the repository and replace all placeholders.
POSTGRES_IMAGE=legend-postgres:replace_me
PGBACKREST_CONFIG=/absolute/path/to/pgbackrest.conf
POSTGRES_DB=legend
POSTGRES_USER=replace_me
POSTGRES_PASSWORD=replace_me
API_IMAGE=legend-api:replace_me
WEB_IMAGE=legend-web:replace_me
WORKER_IMAGE=legend-worker:replace_me
MIGRATOR_IMAGE=legend-migrator:replace_me
MIGRATOR_ENV_FILE=/absolute/path/to/migrator.env
API_ENV_FILE=/absolute/path/to/api.env
WEB_ENV_FILE=/absolute/path/to/web.env
WORKER_ENV_FILE=/absolute/path/to/worker.env
# Trusted operator-supplied transport is required; it is not implemented yet.
WORKER_TRANSPORT_PATH=/absolute/path/to/worker-transport.mjs
TLS_ASK_TOKEN=replace_me
ACME_EMAIL=operator@example.invalid
