# Copy outside the repository; use distinct restricted database roles.
# One private file PER PROCESS (api.env, web.env, worker.env, migrator.env):
# copy only the lines that process needs. Never give API, web or worker the
# migration/owner credentials.
NODE_ENV=production
DEPLOYMENT_MODE=staging
EDGE_MODE=false
DATA_CLASSIFICATION=synthetic
# --- api.env and worker.env: restricted roles only (DATABASE_URL is required by
# the runtime; point it at the same restricted app role, never the owner).
# Login names: legend_runtime_<16 hex> (app), legend_worker_<16 hex> (queue) and
# legend_maint_<16 hex> (audit retention), legend_grant_<16 hex> (payout step grants),
# passwords 48 hex (openssl rand -hex 24). Create the roles after migrating
# with deploy/single-vm/provision-roles.sh; never by hand with the owner login.
DATABASE_URL=postgresql://replace_me:replace_me@postgres:5432/legend
APP_DATABASE_URL=postgresql://replace_me:replace_me@postgres:5432/legend
# --- worker.env only: the isolated queue role.
WORKER_DATABASE_URL=postgresql://replace_me:replace_me@postgres:5432/legend
# --- worker.env only: the audit retention login (legend-usyi). Name
# legend_maint_<16 hex>, password 48 hex; member of legend_maintenance only, it
# runs just the two audit retention functions. Same host and database as the
# other logins. Required to start the cloud worker in production (an edge
# worker does not use it). Never in api.env or web.env.
# MAINTENANCE_DATABASE_URL=postgresql://replace_me:replace_me@postgres:5432/legend
# --- api.env only: the payout step grant login (legend-911). Name
# legend_grant_<16 hex>, password 48 hex; member of legend_payout_grantor only,
# it runs just app.payout_grant_issue. Same host and database as the other
# logins. Required: the API refuses to start in production without it
# (legend-786te). Never in web.env or worker.env.
PAYOUT_GRANTOR_DATABASE_URL=postgresql://replace_me:replace_me@postgres:5432/legend
# --- worker.env only: notification channel providers (legend-18qw). All three
# are required; "disabled" is explicit (in-app notifications still work).
NOTIFICATION_EMAIL_PROVIDER=disabled
NOTIFICATION_PUSH_PROVIDER=disabled
NOTIFICATION_WHATSAPP_PROVIDER=disabled
# Only when NOTIFICATION_EMAIL_PROVIDER=brevo:
# BREVO_API_KEY=replace_me
# NOTIFICATION_EMAIL_FROM=notifikasi@example.invalid
# NOTIFICATION_EMAIL_FROM_NAME=Legend
# --- api.env only, optional: member sign-in email over SMTP and Google sign-in
# (legend-k2l). SMTP_HOST, SMTP_USER, SMTP_PASS and EMAIL_FROM together or
# none (none = email sign-in off); GOOGLE_* both or neither (neither = off).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=replace_me
# SMTP_PASS=replace_me
# EMAIL_FROM=masuk@example.invalid
# GOOGLE_CLIENT_ID=replace_me
# GOOGLE_CLIENT_SECRET=replace_me
# --- migrator.env only: the dedicated migration login (legend-jtnd). Name
# legend_migrator_<16 hex>, password 48 hex; LOGIN NOSUPERUSER BYPASSRLS
# CREATEROLE, owner of the database. Create it once with
# deploy/single-vm/provision-roles.sh --env-file ... --migrator, before the
# first migration. The bootstrap superuser (POSTGRES_USER and POSTGRES_PASSWORD
# in compose.env) is used only by that step and never goes into a service env
# file.
MIGRATION_DATABASE_URL=postgresql://replace_me:replace_me@postgres:5432/legend
# Migrator session limits (docs/deployment.md, Migration lock timeout). Lock
# wait before the migration rolls back and the deploy stops (default 10s), and
# a per-statement limit (default 0 = none, so long backfills finish).
# MIGRATION_LOCK_TIMEOUT=10s
# MIGRATION_STATEMENT_TIMEOUT=0
BETTER_AUTH_SECRET=replace_with_random_secret_at_least_32_characters
DATA_ENCRYPTION_KEY=replace_with_base64_32_byte_key
# Required in production on the CLOUD; its own secret, never BETTER_AUTH_SECRET.
# Never set it on an edge node (the edge refuses to start with it).
# Raise STAFF_PIN_PEPPER_CURRENT_VERSION (default 1) to rotate peppers.
STAFF_PIN_PEPPER=replace_with_a_different_random_secret_of_32_or_more_characters
CONTACT_HASH_SECRET=replace_with_a_different_random_secret
# KirimDev webhook signing secret(s), comma-separated during rotation.
KIRIM_WEBHOOK_SECRET=replace_me
BETTER_AUTH_URL=https://api.example.invalid
WEB_URL=https://app.example.invalid
COOKIE_DOMAIN=.example.invalid
TRUST_PROXY=2
TLS_ASK_TOKEN=replace_me
# Set to the stable web container address; never trust a public address.
PUBLIC_RATE_LIMIT_INTERNAL_IPS=172.29.17.10
