# Copy outside the repository; use distinct restricted database roles.
NODE_ENV=production
DEPLOYMENT_MODE=staging
EDGE_MODE=false
DATA_CLASSIFICATION=synthetic
DATABASE_URL=postgresql://replace_me:replace_me@postgres:5432/legend
APP_DATABASE_URL=postgresql://replace_me:replace_me@postgres:5432/legend
WORKER_DATABASE_URL=postgresql://replace_me:replace_me@postgres:5432/legend
MIGRATION_DATABASE_URL=postgresql://replace_me:replace_me@postgres:5432/legend
BETTER_AUTH_SECRET=replace_with_random_secret_at_least_32_characters
DATA_ENCRYPTION_KEY=replace_with_base64_32_byte_key
BETTER_AUTH_URL=https://api.example.invalid
WEB_URL=https://app.example.invalid
COOKIE_DOMAIN=.example.invalid
TRUST_PROXY=2
TLS_ASK_TOKEN=replace_me
# Set to the stable web container address; never trust a public address.
PUBLIC_RATE_LIMIT_INTERNAL_IPS=172.29.17.10
