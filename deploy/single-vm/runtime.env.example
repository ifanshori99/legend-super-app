# Copy outside the repository; use distinct restricted database roles.
# One private file PER PROCESS (api.env, web.env, worker.env, migrator.env):
# copy only the lines that process needs. Never give API, web or worker the
# migration/owner credentials.
NODE_ENV=production
DEPLOYMENT_MODE=staging
EDGE_MODE=false
DATA_CLASSIFICATION=synthetic
# --- api.env and worker.env: restricted roles only (DATABASE_URL is required by
# the runtime; point it at the same restricted app role, never the owner).
DATABASE_URL=postgresql://replace_me:replace_me@postgres:5432/legend
APP_DATABASE_URL=postgresql://replace_me:replace_me@postgres:5432/legend
# --- worker.env only: the isolated queue role.
WORKER_DATABASE_URL=postgresql://replace_me:replace_me@postgres:5432/legend
# --- worker.env only: notification channel providers (legend-18qw). All three
# are required; "disabled" is explicit (in-app notifications still work).
NOTIFICATION_EMAIL_PROVIDER=disabled
NOTIFICATION_PUSH_PROVIDER=disabled
NOTIFICATION_WHATSAPP_PROVIDER=disabled
# Only when NOTIFICATION_EMAIL_PROVIDER=brevo:
# BREVO_API_KEY=replace_me
# NOTIFICATION_EMAIL_FROM=notifikasi@example.invalid
# NOTIFICATION_EMAIL_FROM_NAME=Legend
# --- migrator.env only: the migration/owner role.
MIGRATION_DATABASE_URL=postgresql://replace_me:replace_me@postgres:5432/legend
BETTER_AUTH_SECRET=replace_with_random_secret_at_least_32_characters
DATA_ENCRYPTION_KEY=replace_with_base64_32_byte_key
# Required in production; its own secret, never BETTER_AUTH_SECRET.
STAFF_PIN_PEPPER=replace_with_a_different_random_secret_of_32_or_more_characters
CONTACT_HASH_SECRET=replace_with_a_different_random_secret
# KirimDev webhook signing secret(s), comma-separated during rotation.
KIRIM_WEBHOOK_SECRET=replace_me
BETTER_AUTH_URL=https://api.example.invalid
WEB_URL=https://app.example.invalid
COOKIE_DOMAIN=.example.invalid
TRUST_PROXY=2
TLS_ASK_TOKEN=replace_me
# Set to the stable web container address; never trust a public address.
PUBLIC_RATE_LIMIT_INTERNAL_IPS=172.29.17.10
