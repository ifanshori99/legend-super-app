# Copy outside the repository; use distinct restricted database roles.
# One private file PER PROCESS (api.env, web.env, worker.env, migrator.env):
# copy only the lines that process needs. Never give API, web or worker the
# migration/owner credentials.
NODE_ENV=production
# Production: DEPLOYMENT_MODE=production and DATA_CLASSIFICATION=real. The values
# below (staging, synthetic) are for a staging copy only.
DEPLOYMENT_MODE=staging
EDGE_MODE=false
DATA_CLASSIFICATION=synthetic
# --- api.env and worker.env: restricted roles only (DATABASE_URL is required by
# the runtime; point it at the same restricted app role, never the owner).
# Login names: legend_runtime_<16 hex> (app), legend_worker_<16 hex> (queue) and
# legend_maint_<16 hex> (audit retention), legend_grant_<16 hex> (payout step grants),
# legend_reseal_<16 hex> (frozen re-seal, optional),
# passwords 48 hex (openssl rand -hex 24). Create the roles after migrating
# with deploy/single-vm/provision-roles.sh; never by hand with the owner login.
DATABASE_URL=postgresql://replace_me:replace_me@postgres:5432/legend
APP_DATABASE_URL=postgresql://replace_me:replace_me@postgres:5432/legend
# --- worker.env only: the isolated queue role.
WORKER_DATABASE_URL=postgresql://replace_me:replace_me@postgres:5432/legend
# --- worker.env only: the audit retention login (legend-usyi). Name
# legend_maint_<16 hex>, password 48 hex; member of legend_maintenance only, it
# runs just the two audit retention functions. Same host and database as the
# other logins. Required to start the cloud worker in production (an edge
# worker does not use it). Never in api.env or web.env.
MAINTENANCE_DATABASE_URL=postgresql://replace_me:replace_me@postgres:5432/legend
# --- worker.env only, optional: the frozen-column re-seal login. Name
# legend_reseal_<16 hex>, password 48 hex; it runs just app.reseal_frozen_sealed.
# Same host and database as the other logins. Without it the worker skips the
# frozen re-seal pass. Never in api.env or web.env.
# RESEAL_DATABASE_URL=postgresql://replace_me:replace_me@postgres:5432/legend
# --- api.env only: the payout step grant login (legend-911). Name
# legend_grant_<16 hex>, password 48 hex; member of legend_payout_grantor only,
# it runs just app.payout_grant_issue. Same host and database as the other
# logins. Required: the API refuses to start in production without it
# (legend-786te). Never in web.env or worker.env.
PAYOUT_GRANTOR_DATABASE_URL=postgresql://replace_me:replace_me@postgres:5432/legend
# --- worker.env only: notification channel providers (legend-18qw). All three
# are required; "disabled" is explicit (in-app notifications still work).
NOTIFICATION_EMAIL_PROVIDER=disabled
NOTIFICATION_PUSH_PROVIDER=disabled
NOTIFICATION_WHATSAPP_PROVIDER=disabled
# Only when NOTIFICATION_EMAIL_PROVIDER=brevo:
# BREVO_API_KEY=replace_me
# NOTIFICATION_EMAIL_FROM=notifikasi@example.invalid
# NOTIFICATION_EMAIL_FROM_NAME=Legend
# --- api.env only, optional: member sign-in email over SMTP and Google sign-in
# (legend-k2l). SMTP_HOST, SMTP_USER, SMTP_PASS and EMAIL_FROM together or
# none (none = email sign-in off); GOOGLE_* both or neither (neither = off).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=replace_me
# SMTP_PASS=replace_me
# EMAIL_FROM=masuk@example.invalid
# GOOGLE_CLIENT_ID=replace_me
# GOOGLE_CLIENT_SECRET=replace_me
# --- migrator.env only: the dedicated migration login (legend-jtnd). Name
# legend_migrator_<16 hex>, password 48 hex; LOGIN NOSUPERUSER BYPASSRLS
# CREATEROLE, owner of the database. Create it once with
# deploy/single-vm/provision-roles.sh --env-file ... --migrator, before the
# first migration. The bootstrap superuser (POSTGRES_USER and POSTGRES_PASSWORD
# in compose.env) is used only by that step and never goes into a service env
# file.
MIGRATION_DATABASE_URL=postgresql://replace_me:replace_me@postgres:5432/legend
# Migrator session limits (docs/deployment.md, Migration lock timeout). Lock
# wait before the migration rolls back and the deploy stops (default 10s), and
# a per-statement limit (default 0 = none, so long backfills finish).
# MIGRATION_LOCK_TIMEOUT=10s
# MIGRATION_STATEMENT_TIMEOUT=0
BETTER_AUTH_SECRET=replace_with_random_secret_at_least_32_characters
DATA_ENCRYPTION_KEY=replace_with_base64_32_byte_key
# Required in production on the CLOUD; its own secret, never BETTER_AUTH_SECRET.
# Never set it on an edge node (the edge refuses to start with it).
# Production requires STAFF_PIN_PEPPER_CURRENT_VERSION >= 2 (the code default is
# 2); raise it to rotate peppers.
# STAFF_PIN_PEPPER_CURRENT_VERSION=2
STAFF_PIN_PEPPER=replace_with_a_different_random_secret_of_32_or_more_characters
CONTACT_HASH_SECRET=replace_with_a_different_random_secret
# KirimDev webhook signing secret(s), comma-separated during rotation.
KIRIM_WEBHOOK_SECRET=replace_me
BETTER_AUTH_URL=https://api.example.invalid
WEB_URL=https://app.example.invalid
COOKIE_DOMAIN=.example.invalid
TRUST_PROXY=2
TLS_ASK_TOKEN=replace_me
# Set to the stable web container address; never trust a public address.
PUBLIC_RATE_LIMIT_INTERNAL_IPS=172.29.17.10
# --- api.env AND web.env, optional (legend-moe5): lets the API charge the public
# per-IP rate limit to the real visitor behind SSR calls. The SAME value in both
# files, min 32 characters; generate with `openssl rand -hex 32`. Unset = the API
# ignores the forwarded visitor IP (old behaviour). Never commit a real value.
# SSR_SHARED_SECRET=replace_with_openssl_rand_hex_32_output
# --- web.env only, used only when SSR_SHARED_SECRET is set: proxies in front of
# the web server, integer >= 1 (default 2 = Cloudflare + Caddy). The visitor IP is
# the X-Forwarded-For entry this many places from the right.
# WEB_TRUST_PROXY_HOPS=2
# --- api.env: object storage (uploads, HRIS files, statement PDFs). The six
# values below (all but ENDPOINT and FORCE_PATH_STYLE) are required together; a
# wrong region silently breaks uploads. Use these names only: OBJECT_STORAGE_*
# is deprecated.
STORAGE_S3_ACCESS_KEY_ID=replace_me
STORAGE_S3_SECRET_ACCESS_KEY=replace_me
STORAGE_S3_PRIVATE_BUCKET=replace_me
STORAGE_S3_PUBLIC_BUCKET=replace_me
STORAGE_PUBLIC_BASE_URL=https://files.example.invalid
STORAGE_S3_REGION=replace_me
# STORAGE_S3_ENDPOINT=https://s3.example.invalid
# STORAGE_S3_FORCE_PATH_STYLE=false
# --- api.env: Duitku callback origin (the API's public origin) and the page the
# customer returns to. https in production, and the path must be /bayar/kembali
# (no query, hash or user info). Unset = the Duitku adapter stays off.
# Merchant code and API key are entered in the app, not here.
DUITKU_CALLBACK_BASE_URL=https://api.example.invalid
DUITKU_RETURN_URL=https://app.example.invalid/bayar/kembali
# --- api.env and worker.env (same value in both): Duitku methods that may take
# money, comma-separated (qris, va, ewallet, card). Empty = all locked. Unlock a
# method only after its sandbox proof; card also needs the chargeback procedure.
DUITKU_ENABLED_METHODS=
# --- api.env and worker.env (same value in both): accept a Duitku sandbox account
# in a production build. true on staging only (sandbox tests fail without it);
# always false in production: a sandbox payment is not money, and the API and
# worker refuse to start with it on (DEPLOYMENT_MODE=production or real data).
DUITKU_ALLOW_SANDBOX=false
# --- api.env: money kill switches. Both stay false until DOIT is verified live;
# the founder turns them on, not the operator.
DOIT_REFUNDS_ENABLED=false
DOIT_RECURRING_ENABLED=false
# --- api.env and worker.env (same value): paid shower room (facilities of type
# shower only; WFC and Wi-Fi are not affected), deferred past release 1 (1269 F0).
# Stays false; the founder turns it on.
FACILITY_SHOWER_ENABLED=false
# --- api.env and worker.env (same value): paid WFC sales (brief 1270). Stays
# false until the founder's numbers and the tax answers are in.
WFC_SALES_ENABLED=false
# --- api.env: edge -> cloud failover (brief 1271 D6). Stays false until the
# failover runbook is rehearsed.
EDGE_FAILOVER_ENABLED=false
# --- api.env: AI gateway. Without a key AI is off (calls answer
# AI_PROVIDER_UNAVAILABLE).
AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=replace_me
# --- api.env: attendance selfie seal. ATTENDANCE_SELFIE_SEAL_KEYS is JSON
# {kid: PKCS#8 PEM} (RSA >= 3072 bit); ACTIVE_KID names the kid edges seal to.
# Keep an old kid 90 days after a switch.
# ATTENDANCE_SELFIE_SEAL_KEYS=replace_me
# ATTENDANCE_SELFIE_SEAL_ACTIVE_KID=replace_me
# --- api.env, optional: key rotation sets.
# DATA_ENCRYPTION_KEYS=replace_me
# HRIS_PII_KEYS=replace_me
# BLIND_INDEX_ACTIVE_VERSION=replace_me
# --- api.env, optional: other integrations.
# PLATFORM_DOMAIN=example.invalid
# KIRIM_API_KEY=replace_me
# DELIVERY_GOFOOD_WEBHOOK_SECRET=replace_me
# DELIVERY_GRABFOOD_WEBHOOK_SECRET=replace_me
# VAPID_PUBLIC_KEY=replace_me
# VAPID_PRIVATE_KEY=replace_me
# VAPID_SUBJECT=mailto:operator@example.invalid
# REDIS_URL=redis://redis:6379
# --- Error reporting, optional: SENTRY_DSN in api.env. The web DSN
# (VITE_SENTRY_DSN) is a build argument of the web image, not an env file key.
# SENTRY_DSN=replace_me
# CLAMD_HOST and CLAMD_PORT come from compose.yaml (service clamav); do not set
# them here.
